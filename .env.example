# ---------------------------------------------------------------------------
# Awqāt — environment
#
# Copy to `.env.local` for development. In production set these in your hosting
# provider's dashboard. `.env.local` and `.env` are gitignored; this file is the
# documented template and must never contain real secrets.
#
# Everything below is OPTIONAL. With none of it set the app still works: prayer
# times are computed on the device and alerts fire while a tab is open. What you
# lose is background delivery — notifications when the app is closed.
# ---------------------------------------------------------------------------


# --- Web Push (VAPID) ------------------------------------------------------
# Identifies this server to the browsers' push services (FCM, Mozilla, Apple).
# Generate a pair with:  npm run vapid
# Generate them ONCE: rotating the keys invalidates every existing subscription.

# Public application server key. Handed to the browser by /api/push/public-key.
VAPID_PUBLIC_KEY=

# Private signing key. SECRET. Never commit it; never prefix it with NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=

# Contact for the push service to reach you about abuse. A `mailto:` address or
# an `https:` URL. Defaults to a placeholder if unset, which some push services
# treat with suspicion — set it before going to production.
VAPID_SUBJECT=mailto:you@example.com

# The same public key, inlined into the client bundle at build time. Used only
# as a fallback when /api/push/public-key cannot be reached (e.g. a static
# export). Safe to expose — it is the public half of the pair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=


# --- Subscription storage (Upstash Redis over REST) ------------------------
# Where push subscriptions live. Required in production: without these, records
# are held in a process-local Map and are LOST on every serverless cold start,
# which stops background notifications with no error anywhere. The app logs a
# loud warning when it falls back to memory.
#
# Create a free database at https://console.upstash.com and copy both values.
# No SDK is installed — the store talks to the REST API with plain fetch.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# --- Cron authorisation ----------------------------------------------------
# Shared secret for /api/cron/dispatch, the job that sends the notifications.
# Vercel automatically attaches `Authorization: Bearer $CRON_SECRET` to its cron
# invocations once this variable exists on the project. When it is unset the
# endpoint answers anyone; the work is idempotent, but set it in production.
# Any long random string will do:  openssl rand -hex 32

CRON_SECRET=
